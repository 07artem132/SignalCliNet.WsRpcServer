<Project Sdk="Microsoft.NET.Sdk">

       <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>1.1.0</AssemblyVersion>
        <FileVersion>1.1.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JSON-RPC.NET" Version="2.7.0" />
      <!-- Durable-стор (G4/R3.7): embedded SQLite. Microsoft-мейнтейнений провайдер, без відомих CVE;
           10.0.x у лінії net10. Тягне SQLitePCLRaw.bundle_e_sqlite3 (нативний SQLite) — з nuget.org. -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
      <!-- Прямий референс потрібен, щоб запустився source-generator [OptionsValidator]
           (аналайзери не течуть транзитивно) — валідатори Deployment/-опцій (A3). -->
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
      <PackageReference Include="NetCoreServer" Version="8.0.7" />
      <!-- CRC32 для checksum-сегмента opaque-токена (fast-reject малформлених токенів БЕЗ
           звернення до стору й HMAC). Microsoft-мейнтейнений, 10.0.x у лінії net10; з nuget.org. -->
      <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
      <PackageReference Include="SignalCli.NET" Version="4.10.1" />
      <PackageReference Include="SignalCli.Runtime" Version="0.14.3.1" />
      <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
      <!-- Закриваємо транзитивну вразливість StreamJsonRpc → MessagePack 2.5.192
           (GHSA-hv8m-jj95-wg3x / NU1903). 2.5.302 — патчена 2.5.x, і саме її тягне
           StreamJsonRpc 2.25.29 транзитивно. -->
      <PackageReference Include="MessagePack" Version="2.5.302" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <!-- Тести звертаються до internal-хелперів Deployment/ (CertificateFactory для renewal-тесту). -->
      <InternalsVisibleTo Include="SignalCliNet.WsRpcServer.Tests" />
    </ItemGroup>

    <!-- SignalCli.Runtime.targets копіює signal-cli лише у build-output ($(TargetDir)),
         тому dotnet publish його не переносить. Доносимо payload у publish-папку власноруч. -->
    <Target Name="CopySignalCliToPublish" AfterTargets="Publish">
      <ItemGroup>
        <_SignalCliPublishFiles Include="$(TargetDir)signal-cli/**/*" />
      </ItemGroup>
      <Copy SourceFiles="@(_SignalCliPublishFiles)"
            DestinationFiles="@(_SignalCliPublishFiles->'$(PublishDir)signal-cli/%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
